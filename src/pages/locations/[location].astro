---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BookingForm } from "@/components/shared/BookingForm";
import EmergencyCTA from "@/components/shared/EmergencyCTA.astro";
import { categories } from "@/data/categories";
import { locations } from "@/data/locations";
import { faqSchema } from "@/lib/seo";
import {
  hubSeed,
  hubTitle,
  hubDescription,
  hubIntro,
  hubCoverage,
  hubLocalKnowledge,
  hubHousingIntro,
  hubScenariosIntro,
  hubFAQs,
  hubServiceMenuHeading,
  hubLocalHeading,
} from "@/lib/locationHubContent";
import { Phone, ShieldCheck, MapPin, Clock, ChevronRight, ArrowRight, Home as HomeIcon, Building2, Car, AlertTriangle, CheckCircle2 } from "lucide-react";
import { hasServicePages } from "@/data/indexingPriority";

export function getStaticPaths() {
  return locations.map((loc) => ({ params: { location: loc.slug }, props: { location: loc } }));
}

const { location } = Astro.props;
const seed = hubSeed(location);

const intro = hubIntro(location, seed);
const coverage = hubCoverage(location, seed);
const localKnowledge = hubLocalKnowledge(location);
const housingIntro = hubHousingIntro(location, seed);
const scenariosIntro = hubScenariosIntro(location, seed);
const faqs = hubFAQs(location, seed);
const menuHeading = hubServiceMenuHeading(location, seed);
const localHeading = hubLocalHeading(location, seed);

const metaTitle = hubTitle(location, seed);
const metaDescription = hubDescription(location, seed);

const knowledgeIcons = [HomeIcon, Building2, Car, AlertTriangle];

const nearbyLocations = location.nearbyLocations
  .map((s) => locations.find((l) => l.slug === s))
  .filter((l): l is NonNullable<typeof l> => Boolean(l));

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: `Garden State Locksmith — ${location.name}`,
  description: metaDescription,
  telephone: "+18565880580",
  areaServed: {
    "@type": "City",
    name: location.name,
    containedInPlace: { "@type": "AdministrativeArea", name: location.county },
  },
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={`/locations/${location.slug}`}
  schema={[schema, faqSchema(faqs)]}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Locations", path: "/locations/" },
    { name: location.name, path: `/locations/${location.slug}/` },
  ]}
>
  <div class="relative overflow-hidden" style="background: #0c1410; min-height: 520px;">
    <img src="/van-bg.jpg" alt="" aria-hidden="true" width="1600" height="900" class="absolute inset-0 w-full h-full object-cover opacity-25 pointer-events-none" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/65 to-black/75 pointer-events-none" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/20 pointer-events-none" />

    <div class="relative container mx-auto px-4 py-20 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <nav class="flex items-center gap-1 text-white/40 text-xs font-semibold uppercase tracking-wide mb-5">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <ChevronRight className="h-3 w-3" />
            <a href="/locations/" class="hover:text-white transition-colors">Locations</a>
            <ChevronRight className="h-3 w-3" />
            <span class="text-accent">{location.name}</span>
          </nav>

          <div class="inline-flex items-center rounded-full border border-accent/50 bg-accent/15 px-3 py-1 text-sm font-semibold text-accent mb-5">
            <span class="flex h-2 w-2 rounded-full bg-accent mr-2 animate-pulse" />
            Fast Response · Licensed NJ Technicians
          </div>

          <p class="text-accent font-bold uppercase tracking-[0.2em] text-xs mb-2">{location.county} · Pop. {location.population}</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold tracking-tight mb-4 text-white">
            Locksmith in<br />
            <span class="text-accent">{location.name}, NJ</span>
          </h1>
          <p class="text-lg text-white/70 mb-6 leading-relaxed max-w-lg">{intro}</p>

          <div class="flex flex-wrap gap-3 mb-6">
            <a href="tel:8565880580" class="flex items-center gap-2 bg-accent text-white font-bold px-7 py-3.5 rounded-full hover:bg-accent/90 transition-colors text-base">
              <Phone className="h-5 w-5" /> (856) 588-0580
            </a>
            <div class="flex items-center gap-2 border border-white/20 text-white/70 font-semibold px-5 py-3 rounded-full text-sm">
              <Clock className="h-4 w-4 text-accent" /> Fast Local Dispatch
            </div>
          </div>

          <div class="flex flex-wrap gap-4 text-sm font-semibold text-white/50">
            <span class="flex items-center gap-1.5"><ShieldCheck className="h-4 w-4 text-accent" /> Licensed & Insured</span>
            <span class="flex items-center gap-1.5"><MapPin className="h-4 w-4 text-accent" /> {location.zipCodes.join(" · ")}</span>
            <span class="flex items-center gap-1.5"><ShieldCheck className="h-4 w-4 text-accent" /> Background-Checked</span>
          </div>
        </div>

        <div class="lg:pl-6">
          <div class="rounded-2xl border border-white/15 p-7" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(12px);">
            <p class="text-accent font-bold uppercase tracking-widest text-xs mb-1">Free Quote</p>
            <h2 class="text-2xl font-serif font-bold text-white mb-1">Schedule Service</h2>
            <p class="text-white/50 text-sm mb-5">Serving {location.name} — we'll call back within minutes.</p>
            <BookingForm client:load darkBg compact />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Coverage + local knowledge -->
  <section class="py-16 bg-background">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="max-w-3xl mb-12">
        <h2 class="font-serif text-3xl font-bold text-foreground mb-4">{localHeading}</h2>
        <p class="text-lg text-muted-foreground leading-relaxed">{coverage}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-14">
        {localKnowledge.map((item, i) => {
          const Icon = knowledgeIcons[i];
          return (
            <div class="p-5 rounded-2xl border border-border/50 bg-muted/20">
              <div class="h-9 w-9 rounded-full bg-primary/10 flex items-center justify-center mb-3">
                <Icon className="h-5 w-5 text-primary" />
              </div>
              <h3 class="font-bold text-foreground mb-1">{item.label}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{item.body}</p>
            </div>
          );
        })}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <!-- Housing stock -->
        <div>
          <h3 class="text-xl font-serif font-bold mb-3 flex items-center gap-2">
            <Building2 className="h-5 w-5 text-primary" /> {location.name} Properties We Work On
          </h3>
          <p class="text-muted-foreground text-sm mb-4 leading-relaxed">{housingIntro}</p>
          <div class="flex flex-wrap gap-2">
            {location.profile.housingStock.map((h) => (
              <span class="bg-background border border-border/60 text-foreground/80 text-sm font-medium px-3 py-1.5 rounded-full">{h}</span>
            ))}
          </div>
          {location.profile.neighborhoods.length > 0 && (
            <div class="mt-5">
              <p class="text-xs font-bold uppercase tracking-wide text-muted-foreground mb-2 flex items-center gap-2">
                <MapPin className="h-3.5 w-3.5" /> {location.name} Neighborhoods
              </p>
              <div class="flex flex-wrap gap-1.5">
                {location.profile.neighborhoods.map((n) => (
                  <span class="bg-muted/40 border border-border/40 text-foreground/70 text-xs font-medium px-2.5 py-1 rounded-full">{n}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Common scenarios -->
        <div>
          <h3 class="text-xl font-serif font-bold mb-3">Common {location.name} Calls</h3>
          <p class="text-muted-foreground text-sm mb-4 leading-relaxed">{scenariosIntro}</p>
          <div class="space-y-3">
            {location.profile.commonScenarios.map((scenario, i) => (
              <div class="flex items-start gap-3 p-4 bg-muted/20 rounded-xl border border-border/40">
                <div class="h-7 w-7 rounded-full bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">
                  <span class="text-xs font-bold text-primary">{i + 1}</span>
                </div>
                <p class="text-sm text-foreground leading-relaxed">{scenario.charAt(0).toUpperCase() + scenario.slice(1)}.</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full service menu -->
  <section class="py-16 bg-muted/30 border-y border-border">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <p class="text-accent font-bold uppercase tracking-widest text-xs mb-3">Full Service Menu</p>
        <h2 class="text-3xl md:text-4xl font-serif font-bold text-foreground mb-3">{menuHeading}</h2>
        <p class="text-muted-foreground">
          From emergency lockouts to commercial access control — we cover every lock, key, and security need across {location.name}.
        </p>
      </div>

      <div class="space-y-10">
        {categories.map((cat) => (
          <div>
            <div class="flex items-center justify-between mb-5 pb-3 border-b border-border/60">
              <div class="flex items-center gap-3">
                <span class="text-3xl">{cat.emoji}</span>
                <div>
                  <h3 class="text-xl md:text-2xl font-serif font-bold text-foreground">{cat.name}</h3>
                  <p class="text-sm text-muted-foreground">{cat.subServices.length} services in {location.name}</p>
                </div>
              </div>
              <a href={`/services/${cat.slug}/`} class="hidden sm:inline-flex items-center gap-1 text-sm font-semibold text-primary hover:text-accent transition-colors">
                View category <ArrowRight className="h-4 w-4" />
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {cat.subServices.map((sub) => (
                <a href={hasServicePages(location.slug) ? `/services/${cat.slug}/${sub.slug}/${location.slug}/` : `/services/${cat.slug}/${sub.slug}/`} class="group flex items-center gap-3 bg-background border border-border/60 rounded-xl p-4 hover:border-accent hover:shadow-md transition-all">
                  <div class="shrink-0 h-9 w-9 rounded-lg bg-primary/10 flex items-center justify-center text-lg group-hover:bg-accent/15 transition-colors">{cat.emoji}</div>
                  <p class="flex-1 min-w-0 font-serif font-bold text-sm text-foreground leading-tight group-hover:text-primary transition-colors">{sub.name} in {location.name}</p>
                  <ArrowRight className="h-4 w-4 text-muted-foreground/40 group-hover:text-accent transition-colors shrink-0" />
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Local FAQs -->
  <section class="py-16 bg-background">
    <div class="container mx-auto px-4 max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-serif font-bold mb-8 text-center">Locksmith in {location.name} — Common Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group border border-border/60 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-serif font-bold text-foreground text-sm md:text-base list-none hover:bg-muted/30 transition-colors [&::-webkit-details-marker]:hidden">
              {faq.q}
              <ChevronRight className="h-4 w-4 text-primary group-open:rotate-90 transition-transform shrink-0 ml-4" />
            </summary>
            <div class="px-6 py-4 border-t border-border/40 text-muted-foreground text-sm leading-relaxed bg-background">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Nearby towns -->
  {nearbyLocations.length > 0 && (
    <section class="py-14 bg-muted/30 border-t border-border">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-xl font-serif font-bold mb-2 text-center">Locksmith Service Near {location.name}</h2>
        <p class="text-muted-foreground text-sm text-center mb-8">We also cover the {location.county} towns right around {location.name}.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {nearbyLocations.map((nl) => (
            <a href={`/locations/${nl.slug}/`} class="flex items-center justify-between p-4 rounded-xl border border-border/50 bg-background hover:border-primary/40 hover:bg-primary/5 transition-all group">
              <div class="flex items-center gap-2">
                <MapPin className="h-4 w-4 text-primary shrink-0" />
                <div>
                  <p class="text-sm font-bold text-foreground group-hover:text-primary transition-colors">{nl.name}</p>
                  <p class="text-xs text-muted-foreground">{nl.county}</p>
                </div>
              </div>
              <ArrowRight className="h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <EmergencyCTA description={`Our mobile locksmiths serve ${location.name}, NJ — licensed, fast, and local.`} />
</BaseLayout>
